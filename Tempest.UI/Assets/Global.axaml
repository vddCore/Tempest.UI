<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=System.Runtime">
    <x:Double x:Key="Breeze::Global.Shared.DisabledControlOpacity">0.3</x:Double>

    <x:Double x:Key="Breeze::Global.Button.MinHeight">31</x:Double>
    <x:Double x:Key="Breeze::Global.Button.MinWidth">75</x:Double>
    <Thickness x:Key="Breeze::Global.Button.Padding">12,4</Thickness>
    <CornerRadius x:Key="Breeze::Global.Button.CornerRadius">4</CornerRadius>
    
    <x:Double x:Key="Breeze::Global.SplitButton.SecondaryWidth">21</x:Double>
    <Geometry x:Key="Breeze::Global.SplitButton.SecondaryChevronPath">M 0 0 L 4 4 L 8 0</Geometry>
    
    <x:Double x:Key="Breeze::Global.GroupBox.HeaderFontSize">12</x:Double>
    <Thickness x:Key="Breeze::Global.GroupBox.HeaderPadding">4,0</Thickness>
    <Thickness x:Key="Breeze::Global.GroupBox.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Breeze::Global.GroupBox.CornerRadius">4</CornerRadius>
    
    <CornerRadius x:Key="Breeze::Global.Window.BorderOnlyCornerRadius">7</CornerRadius>
</ResourceDictionary>
