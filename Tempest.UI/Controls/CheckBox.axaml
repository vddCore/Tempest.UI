<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Background" Value="{DynamicResource Breeze::Button.BackgroundNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource Breeze::Button.ForegroundNormal}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Breeze::Shared.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Breeze::Global.CheckBox.BaseBoxCornerRadius}" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                    <Panel Grid.Column="0"
                           Width="{DynamicResource Breeze::Global.CheckBox.BaseBoxSize}"
                           Height="{DynamicResource Breeze::Global.CheckBox.BaseBoxSize}"
                           VerticalAlignment="Center">

                        <Border Name="PART_BaseBox"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                        <Border Name="PART_CheckedPlate"
                                Background="{DynamicResource Breeze::Shared.Accent.20}"
                                BorderBrush="{DynamicResource Breeze::Shared.Accent.40}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.150"
                                                      Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <Border Name="PART_FocusOverlay"
                                BorderBrush="{DynamicResource Breeze::Shared.Accent.40}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.150"
                                                      Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <Border Name="PART_HoverOverlay"
                                BorderBrush="{DynamicResource Breeze::Shared.Accent.60}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.150"
                                                      Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <Border Name="PART_PressedOverlay"
                                Background="{DynamicResource Breeze::Shared.Accent.40}"
                                BorderBrush="{DynamicResource Breeze::Shared.Accent.60}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.100"
                                                      Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <Path Name="PART_CheckGlyph"
                              Width="{DynamicResource Breeze::Global.CheckBox.CheckGlyphWidth}"
                              Height="{DynamicResource Breeze::Global.CheckBox.CheckGlyphHeight}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{DynamicResource Breeze::Global.CheckBox.CheckMarkPath}"
                              Stroke="{DynamicResource Breeze::Button.ForegroundNormal}"
                              StrokeThickness="{DynamicResource Breeze::Global.CheckBox.CheckGlyphThickness}"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Opacity="0"
                              IsHitTestVisible="False">
                            <Path.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.150"
                                                      Easing="CubicEaseOut" />
                                </Transitions>
                            </Path.Transitions>
                        </Path>

                        <Rectangle Name="PART_IndeterminateGlyph"
                                   Width="{DynamicResource Breeze::Global.CheckBox.IndeterminateGlyphWidth}"
                                   Height="{DynamicResource Breeze::Global.CheckBox.IndeterminateGlyphHeight}"
                                   RadiusX="1"
                                   RadiusY="1"
                                   Fill="{DynamicResource Breeze::Button.ForegroundNormal}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0"
                                   IsHitTestVisible="False">
                            <Rectangle.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.150"
                                                      Easing="CubicEaseOut" />
                                </Transitions>
                            </Rectangle.Transitions>
                        </Rectangle>
                    </Panel>

                    <ContentPresenter Name="PART_ContentPresenter"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:checked /template/ Border#PART_CheckedPlate">
            <Setter Property="Opacity" Value="1" />
        </Style>
        
        <Style Selector="^:checked /template/ Path#PART_CheckGlyph">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:indeterminate /template/ Border#PART_CheckedPlate">
            <Setter Property="Opacity" Value="1" />
        </Style>
        
        <Style Selector="^:indeterminate /template/ Rectangle#PART_IndeterminateGlyph">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:focus /template/ Border#PART_FocusOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:pointerover /template/ Border#PART_HoverOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>
        
        <Style Selector="^:focus:pointerover /template/ Border#PART_HoverOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_PressedOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Breeze::Global.Shared.DisabledControlOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>