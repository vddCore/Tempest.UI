<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
        <Setter Property="Background" Value="{DynamicResource Breeze::Button.BackgroundNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource Breeze::Button.ForegroundNormal}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Breeze::Shared.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                    <Panel Grid.Column="0"
                           Width="{DynamicResource Breeze::Global.RadioButton.BaseCircleSize}"
                           Height="{DynamicResource Breeze::Global.RadioButton.BaseCircleSize}"
                           VerticalAlignment="Center">

                        <Border Name="PART_BaseCircle"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Breeze::Global.RadioButton.BaseCircleCornerRadius}" />

                        <Border Name="PART_CheckedPlate"
                                Background="{DynamicResource Breeze::Shared.Accent.20}"
                                BorderBrush="{DynamicResource Breeze::Shared.Accent.40}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Breeze::Global.RadioButton.BaseCircleCornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.150"
                                                      Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        
                        <Border Name="PART_FocusOverlay"
                                BorderBrush="{DynamicResource Breeze::Shared.Accent.40}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Breeze::Global.RadioButton.BaseCircleCornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.150"
                                                      Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <Border Name="PART_HoverOverlay"
                                BorderBrush="{DynamicResource Breeze::Shared.Accent.60}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Breeze::Global.RadioButton.BaseCircleCornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.150"
                                                      Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <Border Name="PART_PressedOverlay"
                                Background="{DynamicResource Breeze::Shared.Accent.20}"
                                BorderBrush="{DynamicResource Breeze::Shared.Accent.60}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Breeze::Global.RadioButton.BaseCircleCornerRadius}"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.100"
                                                      Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <Ellipse Name="PART_GlyphPip"
                                 Width="{DynamicResource Breeze::Global.RadioButton.GlyphPipSize}"
                                 Height="{DynamicResource Breeze::Global.RadioButton.GlyphPipSize}"
                                 Fill="{DynamicResource Breeze::Button.ForegroundNormal}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Opacity="0"
                                 IsHitTestVisible="False">
                            <Ellipse.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.150"
                                                      Easing="CubicEaseOut" />
                                </Transitions>
                            </Ellipse.Transitions>
                        </Ellipse>
                    </Panel>

                    <ContentPresenter Name="PART_ContentPresenter"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:checked /template/ Border#PART_CheckedPlate">
            <Setter Property="Opacity" Value="1" />
        </Style>
        
        <Style Selector="^:checked /template/ Ellipse#PART_GlyphPip">
            <Setter Property="Opacity" Value="1" />
        </Style>
        
        <Style Selector="^:focus /template/ Border#PART_FocusOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:pointerover /template/ Border#PART_HoverOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>
        
        <Style Selector="^:focus:pointerover /template/ Border#PART_HoverOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_PressedOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Breeze::Global.Shared.DisabledControlOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>