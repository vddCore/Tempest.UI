<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="{DynamicResource Breeze::Global.Button.MinHeight}" />
        <Setter Property="MinWidth" Value="{DynamicResource Breeze::Global.Button.MinWidth}" />
        <Setter Property="Padding" Value="{DynamicResource Breeze::Global.Button.Padding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{DynamicResource Breeze::Global.Button.CornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="Background" Value="{DynamicResource Breeze::Button.BackgroundNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource Breeze::Button.ForegroundNormal}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Breeze::Shared.Border}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />

                    <Border Name="PART_CheckedBorder"
                            Background="{DynamicResource Breeze::Shared.Accent.20}"
                            BorderBrush="{DynamicResource Breeze::Shared.Accent.60}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.150"
                                                  Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border Name="PART_FocusBorder"
                            BorderBrush="{DynamicResource Breeze::Shared.Accent.40}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.150"
                                                  Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border Name="PART_HoverBorder"
                            BorderBrush="{DynamicResource Breeze::Shared.Accent.60}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.150"
                                                  Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border Name="PART_PressedBorder"
                            Background="{DynamicResource Breeze::Shared.Accent.40}"
                            BorderBrush="{DynamicResource Breeze::Shared.Accent.60}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="0:0:0.100"
                                                  Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:checked /template/ Border#PART_CheckedBorder">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:indeterminate /template/ Border#PART_CheckedBorder">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <Style Selector="^:focus /template/ Border#PART_FocusBorder">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:pointerover /template/ Border#PART_HoverBorder">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:focus:pointerover /template/ Border#PART_HoverBorder">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_PressedBorder">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Breeze::Global.Shared.DisabledControlOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
