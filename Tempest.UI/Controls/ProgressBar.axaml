<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
        <Setter Property="MinHeight" Value="{DynamicResource Breeze::Global.ProgressBar.Horizontal.Height}" />
        <Setter Property="Height" Value="{DynamicResource Breeze::Global.ProgressBar.Horizontal.Height}" />
        <Setter Property="MinWidth" Value="{DynamicResource Breeze::Global.ProgressBar.Horizontal.MinWidth}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Breeze::Global.ProgressBar.CornerRadius}" />

        <Setter Property="Background" Value="{DynamicResource Breeze::Button.BackgroundNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource Breeze::Shared.Accent.60}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Breeze::Shared.Border}" />
        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Panel Name="PART_Track">
                        <Border Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Width"
                                                      Duration="0:0:0.250"
                                                      Easing="CubicEaseOut" />
                                    <DoubleTransition Property="Height"
                                                      Duration="0:0:0.250"
                                                      Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>

                        <Border Name="PART_IndeterminateBar"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsVisible="False"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                        </Border>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:horizontal /template/ Border#PART_Indicator">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="^:horizontal /template/ Border#PART_IndeterminateBar">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="-56,0,-56,0" />

            <!-- - - - - - - - - - - // NOTICE //
               | indeterminate brushes defined @ Assets/Global.axaml 
               \ because they weren't detected from here.
                 
                 to future aura: check if they finally fixed dynamic \
                 resource colors for GradientStops inside templates. |
                                    // NOTICE // - - - - - - - - - - -->
            
            <Setter Property="Background"
                    Value="{DynamicResource Breeze::Global.ProgressBar.Horizontal.IndeterminateBrush}" />
        </Style>

        <Style Selector="^:horizontal:indeterminate /template/ Border#PART_IndeterminateBar">
            <Setter Property="IsVisible" Value="True" />
            <Style.Animations>
                <Animation Duration="0:0:0.750"
                           IterationCount="Infinite"
                           Easing="LinearEasing"
                           PlaybackBehavior="Always">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="-28" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^:vertical">
            <Setter Property="MinWidth" Value="{DynamicResource Breeze::Global.ProgressBar.Vertical.Width}" />
            <Setter Property="Width" Value="{DynamicResource Breeze::Global.ProgressBar.Vertical.Width}" />
            <Setter Property="MinHeight" Value="{DynamicResource Breeze::Global.ProgressBar.Vertical.MinHeight}" />
            <Setter Property="Height" Value="NaN" />
        </Style>

        <Style Selector="^:vertical /template/ Border#PART_Indicator">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style Selector="^:vertical /template/ Border#PART_IndeterminateBar">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,-56,0,-56" />
            <Setter Property="Background"
                    Value="{DynamicResource Breeze::Global.ProgressBar.Vertical.IndeterminateBrush}" />
        </Style>

        <Style Selector="^:vertical:indeterminate /template/ Border#PART_IndeterminateBar">
            <Setter Property="IsVisible" Value="True" />
            <Style.Animations>
                <Animation Duration="0:0:0.750"
                           IterationCount="Infinite"
                           Easing="LinearEasing"
                           PlaybackBehavior="Always">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.Y" Value="-28" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^:not(:indeterminate) /template/ Border#PART_Indicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:not(:indeterminate) /template/ Border#PART_IndeterminateBar">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:indeterminate /template/ Border#PART_Indicator">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource Breeze::Global.Shared.DisabledControlOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>