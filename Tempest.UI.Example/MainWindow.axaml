<kde:PlasmaWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kde="clr-namespace:Tempest.UI.Controls;assembly=Tempest.UI"
        MinHeight="0"
        MinWidth="0"
        x:Class="Tempest.UI.Example.MainWindow"
        WindowDecorations="Full"
        Title="Tempest.UI.Example">
    <StackPanel Spacing="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <Button Content="Hello, world!" />
        
        <Button Content="Hello, world!"
                IsEnabled="False" />
    </StackPanel>
</kde:PlasmaWindow>
