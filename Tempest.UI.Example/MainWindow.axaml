<kde:PlasmaWindow x:Class="Tempest.UI.Example.MainWindow"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:kde="clr-namespace:Tempest.UI.Controls;assembly=Tempest.UI"
                  MinHeight="0"
                  MinWidth="0"
                  Title="Tempest UI Demonstration Program"
                  WindowDecorations="Full">
    <Grid Margin="6,2,6,6">
        <GroupBox Header="Buttons"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
            <StackPanel Spacing="4">
                <StackPanel Spacing="4"
                            Orientation="Horizontal">
                    <Button Content="Normal" />

                    <Button Content="Disabled"
                            IsEnabled="False" />

                    <ToggleButton Content="Toggle" />
                </StackPanel>
                
                <StackPanel Spacing="4"
                            Orientation="Horizontal">
                    <SplitButton Content="Split"
                                 HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</kde:PlasmaWindow>